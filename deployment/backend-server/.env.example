# Backend Environment Variables
# Copy this to .env and update with your actual values

# Application Settings
APP_NAME=amzur-simple-chatbot
ENVIRONMENT=production

# Database - PostgreSQL (Update with your database credentials)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://chatbot_user:your_secure_password@postgres-server:5432/chatbot_db
CHROMA_PERSIST_DIR=/var/www/chatbot-backend/chroma_db

# Amzur LiteLLM Proxy Configuration
LITELLM_PROXY_URL=https://litellm.amzur.com
LITELLM_API_KEY=sk-your-litellm-api-key-here
LLM_MODEL=gpt-4o
LITELLM_EMBEDDING_MODEL=text-embedding-3-large
IMAGE_GEN_MODEL=gemini/imagen-4.0-fast-generate-001

# Google Gemini API (Get from https://aistudio.google.com/app/apikey)
GOOGLE_GEMINI_API_KEY=your-google-gemini-api-key-here
GEMINI_IMAGE_MODEL=gemini-2.0-flash

# JWT/Authentication Configuration
# IMPORTANT: Change SECRET_KEY to a secure random string in production!
# Generate with: openssl rand -hex 32
SECRET_KEY=your-super-secure-random-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Research Service Configuration (Optional)
RESEARCH_CACHE_TTL_MINUTES=90
RESEARCH_ARXIV_MAX_RETRIES=3
RESEARCH_ARXIV_BACKOFF_SECONDS=1.0
RESEARCH_ARXIV_MIN_REQUEST_INTERVAL_SECONDS=3.5
RESEARCH_ARXIV_TIMEOUT_SECONDS=30.0
RESEARCH_ARXIV_USER_AGENT=amzur-research-digest/1.0 (mailto:support@example.com)
RESEARCH_MCP_SERVER_SCRIPT=/var/www/chatbot-backend/mcp_server/server.py
RESEARCH_MCP_SERVER_CWD=/var/www/chatbot-backend
RESEARCH_MCP_TOOL_TIMEOUT_SECONDS=45.0
RESEARCH_MCP_LOG_LEVEL=INFO

# CORS Configuration (Update with your frontend URL)
FRONTEND_URL=http://your-frontend-server:80

# Logging
LOG_LEVEL=INFO
